# Create a PostgreSQL database (Neon, Supabase, or another managed PostgreSQL provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Use a random secret of at least 32 characters
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional: used by seed script for initial admin account
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThis-Admin-Password-123!"
